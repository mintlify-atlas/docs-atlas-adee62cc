  "keyFeatures": [
    "Lightweight Linux distribution optimized for cloud and edge",
    "Complete RPM-based package build system with 1500+ packages",
    "Multi-stage build system (toolchain, packages, images)",
    "Multiple image format support (ISO, VHD, VHDX, containers)",
    "Security-hardened with production build recommendations",
    "Image customization via JSON configuration files",
    "Support for both package-based and image-based updates",
    "Cloud-init integration for automated provisioning",
    "UEFI and legacy BIOS boot support",
    "Multiple architecture support (x86_64, aarch64)"
  ],
  "publicApiSurface": [
    "make image - Build system images from configurations",
    "make iso - Generate bootable ISO images",
    "make toolchain - Build the compiler toolchain",
    "make packages - Build RPM packages",
    "make meta-user-data - Generate cloud-init configuration",
    "imagegen - Image generation tool",
    "imagecustomizer - Image customization tool",
    "grapher - Package dependency analyzer",
    "pkggen - Package generation tool",
    "scheduler - Parallel build scheduler",
    "imageconfigvalidator - Validate image configurations",
    "specreader - Parse RPM spec files",
    "licensecheck - Verify package licenses",
    "downloader - Download package sources"
  ]
